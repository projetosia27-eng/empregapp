rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catch-all to deny unhandled access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function existing() { return resource.data; }
    function incoming() { return request.resource.data; }

    function isValidUser() {
      let data = incoming();
      return data.keys().hasAll(['email', 'createdAt'])
        && data.email is string && data.email.size() <= 200
        && data.createdAt == request.time;
    }

    function isValidUserUpdate() {
      let data = incoming();
      return data.keys().hasAll(['email', 'createdAt'])
        && data.email is string && data.email.size() <= 200
        && data.createdAt == existing().createdAt;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      // No blanket list queries
      allow create: if isOwner(userId) && isValidUser();
      allow update: if isOwner(userId) && isValidUserUpdate();

      match /resumes/{resumeId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) 
          && incoming().keys().hasAll(['areaInteresse', 'createdAt'])
          && incoming().areaInteresse is string && incoming().areaInteresse.size() <= 100
          && incoming().createdAt == request.time;
        allow update: if isOwner(userId)
          && incoming().keys().hasAll(['areaInteresse', 'createdAt', 'updatedAt'])
          && incoming().areaInteresse is string && incoming().areaInteresse.size() <= 100
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time;
      }

      match /savedJobs/{jobId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && incoming().keys().hasAll(['titulo', 'status', 'createdAt'])
          && incoming().titulo is string && incoming().titulo.size() <= 200
          && incoming().status is string && incoming().status.size() <= 20
          && incoming().createdAt == request.time;
        allow update: if isOwner(userId)
          && incoming().keys().hasAll(['titulo', 'status', 'createdAt'])
          && incoming().titulo is string && incoming().titulo.size() <= 200
          && incoming().status is string && incoming().status.size() <= 20
          && incoming().createdAt == existing().createdAt;
        allow delete: if isOwner(userId);
      }
    }
  }
}
